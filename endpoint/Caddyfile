:80 {
    log

    route {

        # ------------------------------------------------------------
        #                         Security headers
        # ------------------------------------------------------------
        # SECURITY: Restricts the scripts in the browser from communicating with external sources
        header Content-Security-Policy "
            default-src         'self';
            script-src          'self' 'unsafe-inline' 'unsafe-eval';
            style-src           'self' 'unsafe-inline';
            img-src             'self' data:;
            font-src            'self' data:;
            connect-src         'self';
            frame-ancestors     'self';
            frame-src           'self';
            child-src           'self';
            form-action         'self';
            base-uri            'self';
            worker-src          'self';
            upgrade-insecure-requests;
        "

        # SECURITY: Force HTTPS for this domain
        header Strict-Transport-Security "max-age=31536000"
        # ------------------------------------------------------------
        # ------------------------------------------------------------
        # ------------------------------------------------------------







        # DBGate endpoint
        redir /dbgate /dbgate/
        handle /dbgate/* {
            reverse_proxy veiklos-dbgate:3000 {
                header_up X-Forwarded-For {http.request.header.X-Forwarded-For}
            }
        }



        # Backend - SAML single logout endpoint. VU's IdP ends a
        # user's other logins by loading each service's logout
        # endpoint in an iframe on sso.vu.lt (sso.test.vu.lt on
        # test), so those two origins may frame THIS path only;
        # every other response keeps frame-ancestors 'self'
        handle /auth/saml/logout/callback {
            header Content-Security-Policy "frame-ancestors\s+'self';" "frame-ancestors 'self' https://sso.vu.lt https://sso.test.vu.lt;"
            reverse_proxy veiklos-backend:4000 {
                header_up X-Forwarded-Proto https
            }
        }


        # Backend - SAML
        handle /auth/saml/* {
            reverse_proxy veiklos-backend:4000 {
                header_up X-Forwarded-Proto https
            }
        }


        # Backend - API
        handle /api/* {
            reverse_proxy veiklos-backend:4000 {
                header_up X-Forwarded-Proto https
            }
        }



        # Frontend
        handle {
            reverse_proxy veiklos-vite:80
        }


    }
}